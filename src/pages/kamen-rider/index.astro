---
// src/pages/kamen-rider/index.astro
import Layout from '../../layouts/Layout.astro';
import ModelCard from '../../components/ModelCard.astro';
import PipelineCompilingBanner from '../../components/PipelineCompilingBanner.astro';
import { getModelsByFranchise, getExportData } from '../../lib/data';

const exportData = getExportData();
const krModels = getModelsByFranchise('kamen_rider');
const hasModels = krModels.length > 0;

// Sub-series metadata for Kamen Rider
const subSeries = [
  { slug: 'geats', name: 'Geats', year: '2022–2023', flagship: 'Desire Driver' },
  { slug: 'gotchard', name: 'Gotchard', year: '2023–2024', flagship: 'GotcharDriver' },
  { slug: 'gavv', name: 'Gavv', year: '2024–2025', flagship: 'Henshin Belt Gavv' },
  { slug: 'zero-one', name: 'Zero-One', year: '2019–2020', flagship: 'Hiden Zero-One Driver' },
  { slug: 'build', name: 'Build', year: '2017–2018', flagship: 'Build Driver' },
  { slug: 'decade', name: 'Decade', year: '2009', flagship: 'Decadriver (CSM / DX)' },
  { slug: 'kuuga', name: 'Kuuga', year: '2000', flagship: 'Arcle (CSM)' },
  { slug: 'faiz', name: '555 (Faiz)', year: '2003', flagship: 'Faiz Driver 2.0' },
  { slug: 'blade', name: 'Blade', year: '2004', flagship: 'BlayBuckle' },
  { slug: 'w', name: 'W (Double)', year: '2009', flagship: 'Double Driver (CSM)' },
  { slug: 'ooo', name: 'OOO', year: '2010', flagship: 'OOO Driver 10th' }
];
---

<Layout 
  title="Kamen Rider Sold Price Guide & Index"
  description="Verified Tokyo secondary sold prices for Kamen Rider transformation belts, CSM replicas, and Bandai collectibles. Medians from Mercari & Yahoo! Auctions."
>
  <div class="hub-header-section">
    <div class="container hub-header-inner">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Kamen Rider</span>
      </nav>

      <div class="hub-title-block">
        <span class="badge badge-cib">FRANCHISE INDEX</span>
        <h1 class="hub-headline">Kamen Rider Secondary Sold-Price Index</h1>
        <p class="hub-subhead">
          Authoritative price benchmarks for DX henshin belts, Complete Selection Modification (CSM) replicas, and Memorial Edition items. Prices calculated strictly from verified completed transactions across Tokyo’s secondary platforms.
        </p>
      </div>

      <!-- Sub-series filter pills -->
      <div class="subseries-strip">
        <span class="strip-label">Series:</span>
        <div class="subseries-scroll">
          {subSeries.map(s => (
            <span class="subseries-chip">
              <strong class="chip-name">{s.name}</strong>
              <span class="chip-year tabular">{s.year}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container hub-body">
    {!hasModels ? (
      <div class="compiling-wrapper">
        <PipelineCompilingBanner />
        
        <div class="upcoming-catalog-card card">
          <h3 class="card-title">Queued Kamen Rider Catalog For Next Pipeline Export</h3>
          <p class="card-desc">
            The data pipeline is calculating rolling 30-day medians, condition spreads, and volume velocity for the following canonical Kamen Rider releases:
          </p>
          <div class="catalog-preview-grid">
            {subSeries.map(s => (
              <div class="catalog-preview-item">
                <div class="item-series-title font-mono">{s.name} ({s.year})</div>
                <div class="item-flagship">Flagship: <strong>{s.flagship}</strong></div>
                <span class="badge badge-cib">Awaiting Daily Export</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="models-grid-section">
        <div class="grid-header">
          <h2>Active Kamen Rider Models ({krModels.length})</h2>
          <span class="freshness-tag tabular">Updated {exportData.lastExportAt.slice(0, 10)}</span>
        </div>
        <div class="models-grid">
          {krModels.map(m => (
            <ModelCard model={m} />
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .hub-header-section {
    background-color: var(--surface-raised);
    border-bottom: 1px solid var(--border-default);
    padding: 2.5rem 0 2rem;
  }

  .hub-header-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .breadcrumb-nav a:hover {
    color: var(--action-primary);
  }

  .breadcrumb-nav .sep {
    color: var(--text-subtle);
  }

  .breadcrumb-nav .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hub-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 800px;
  }

  .hub-headline {
    font-size: 2.25rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .hub-subhead {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .subseries-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-default);
    overflow: hidden;
  }

  .strip-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-subtle);
    flex-shrink: 0;
  }

  .subseries-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }

  .subseries-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: var(--surface-sunken);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-pill);
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .chip-year {
    color: var(--text-subtle);
    font-size: 0.6875rem;
  }

  .hub-body {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .upcoming-catalog-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--border-default);
  }

  .card-title {
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .catalog-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .catalog-preview-item {
    background-color: var(--surface-sunken);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-control);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .item-series-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .item-flagship {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .models-grid-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .grid-header h2 {
    font-size: 1.25rem;
  }

  .freshness-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .models-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 860px) {
    .catalog-preview-grid {
      grid-template-columns: 1fr;
    }

    .models-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
