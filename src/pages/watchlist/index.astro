---
// src/pages/watchlist/index.astro
import Layout from '../../layouts/Layout.astro';
import { getExportData, getAllModels } from '../../lib/data';

const exportData = getExportData();
const allModels = getAllModels();
---

<Layout 
  title="Collection Watchlist & Portfolio Valuation"
  description="Client-side tokusatsu portfolio tracker. Calculate your Kamen Rider belts and Ultraman collectibles' live valuation based on Tokyo market sold medians."
>
  <div class="watchlist-header-section">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Collection Watchlist</span>
      </nav>

      <div class="header-content">
        <span class="badge badge-cib">PRIVATE LOCAL STORAGE TOOL</span>
        <h1 class="header-headline">Tokusatsu Collection Portfolio Valuation</h1>
        <p class="header-desc">
          Add the transformation belts, replicas, and figures you own or monitor. Your total collection worth is calculated dynamically from rolling Tokyo secondary market medians. Data is stored 100% privately in your browser.
        </p>
      </div>

      <!-- Live Valuation Summary Card -->
      <div class="valuation-summary-card card">
        <div class="summary-col">
          <span class="summary-label">COLLECTION ASSET VALUE (JPY)</span>
          <div class="summary-primary font-mono tabular" id="total-valuation-jpy">¥0</div>
          <span class="summary-sub tabular" id="total-valuation-usd">~$0.00 USD</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-col">
          <span class="summary-label">ITEMS TRACKED</span>
          <div class="summary-secondary font-mono tabular" id="total-items-count">0 items</div>
          <span class="summary-sub" id="valuation-exchange-stamp">Rate: 1 USD = {exportData.exchangeRateUsdJpy.toFixed(2)} JPY</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-col summary-action-col">
          <button type="button" class="btn btn-ghost btn-sm" id="clear-watchlist-btn">
            Clear Watchlist
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="container watchlist-body">
    <!-- Watchlist Table / Grid -->
    <div id="watchlist-items-container">
      <!-- Populated via Client Script -->
    </div>

    <!-- Empty Watchlist State -->
    <div id="watchlist-empty-state" class="empty-watchlist-card card" style="display: none;">
      <div class="empty-icon">📦</div>
      <h3>Your Watchlist Is Empty</h3>
      <p>
        You haven't added any Kamen Rider belts or Ultraman replicas to your collection yet. Browse the franchise catalogs or model pages and click <strong>+ Add to Watchlist</strong>.
      </p>
      <div class="empty-actions">
        <a href="/kamen-rider/" class="btn btn-primary">Browse Kamen Rider</a>
        <a href="/ultraman/" class="btn btn-secondary">Browse Ultraman</a>
      </div>
    </div>
  </div>

  <!-- Embed catalog for client autocomplete / lookup -->
  <script type="application/json" id="watchlist-catalog-payload">
    {JSON.stringify(allModels)}
  </script>
</Layout>

<style>
  .watchlist-header-section {
    background-color: var(--surface-raised);
    border-bottom: 1px solid var(--border-default);
    padding: 2.5rem 0 2rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .breadcrumb-nav a:hover {
    color: var(--action-primary);
  }

  .breadcrumb-nav .sep {
    color: var(--text-subtle);
  }

  .breadcrumb-nav .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .header-headline {
    font-size: 2.25rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .header-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .valuation-summary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    background: linear-gradient(180deg, #ffffff 0%, var(--surface-sunken) 100%);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-card);
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .summary-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .summary-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-subtle);
    letter-spacing: 0.05em;
  }

  .summary-primary {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--action-primary);
    line-height: 1.1;
  }

  .summary-secondary {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .summary-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .summary-divider {
    width: 1px;
    height: 48px;
    background-color: var(--border-default);
  }

  .watchlist-body {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .watchlist-table-card {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-card);
    overflow: hidden;
  }

  .watchlist-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .watchlist-table th {
    background-color: var(--surface-sunken);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border-default);
  }

  .watchlist-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-default);
    vertical-align: middle;
  }

  .col-item-title {
    font-weight: 700;
    color: var(--text-primary);
    display: block;
  }

  .col-item-title:hover {
    color: var(--action-primary);
  }

  .col-item-ja {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .condition-select {
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-control);
    background-color: var(--surface-raised);
    color: var(--text-primary);
  }

  .val-cell {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1rem;
  }

  .val-usd-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: normal;
  }

  .btn-remove {
    color: var(--state-error);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }

  .btn-remove:hover {
    background-color: var(--state-error-surface);
  }

  .empty-watchlist-card {
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background-color: var(--surface-raised);
    border: 1px dashed var(--border-subtle);
  }

  .empty-icon {
    font-size: 3rem;
    line-height: 1;
  }

  .empty-watchlist-card h3 {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .empty-watchlist-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 440px;
    line-height: 1.5;
  }

  .empty-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .summary-divider {
      display: none;
    }

    .valuation-summary-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .watchlist-table th, .watchlist-table td {
      padding: 0.75rem 0.5rem;
    }
  }
</style>

<script is:inline>
  (function() {
    let catalog = [];
    try {
      const payloadEl = document.getElementById('watchlist-catalog-payload');
      if (payloadEl) catalog = JSON.parse(payloadEl.textContent || '[]');
    } catch (e) {}

    const totalJpyEl = document.getElementById('total-valuation-jpy');
    const totalUsdEl = document.getElementById('total-valuation-usd');
    const totalCountEl = document.getElementById('total-items-count');
    const container = document.getElementById('watchlist-items-container');
    const emptyState = document.getElementById('watchlist-empty-state');
    const clearBtn = document.getElementById('clear-watchlist-btn');

    const exchangeRate = 149.80;

    function renderWatchlist() {
      let list = [];
      try {
        list = JSON.parse(localStorage.getItem('tokuprice_watchlist') || '[]');
      } catch (e) {}

      if (!list.length) {
        if (container) container.innerHTML = '';
        if (emptyState) emptyState.style.display = 'flex';
        if (totalJpyEl) totalJpyEl.textContent = '¥0';
        if (totalUsdEl) totalUsdEl.textContent = '~$0.00 USD';
        if (totalCountEl) totalCountEl.textContent = '0 items';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';

      let totalJpy = 0;
      let html = `
        <div class="watchlist-table-card card">
          <table class="watchlist-table">
            <thead>
              <tr>
                <th>Model</th>
                <th>Franchise</th>
                <th>Condition</th>
                <th style="text-align: right;">Tokyo Median</th>
                <th style="text-align: center;">Action</th>
              </tr>
            </thead>
            <tbody>
      `;

      list.forEach((item, idx) => {
        // Try finding latest price from catalog if loaded
        const match = catalog.find(m => m.slug === item.slug);
        const condition = item.condition || 'cib';
        let jpy = item.priceJpy || 0;
        
        if (match && match.metrics?.byCondition) {
          const condKey = condition === 'sealed' ? 'new_sealed' : condition === 'used' ? 'used' : 'like_new';
          const p = match.metrics.byCondition[condKey]?.medianPriceJpy;
          if (p) jpy = p;
        }

        totalJpy += jpy;
        const usd = jpy / exchangeRate;
        const modelUrl = `/${item.franchise || 'kamen-rider'}/${item.series || 'geats'}/${item.slug}/`;

        html += `
          <tr>
            <td>
              <a href="${modelUrl}" class="col-item-title">${item.name}</a>
              <span class="col-item-ja font-jp">${item.ja || ''}</span>
            </td>
            <td>
              <span class="badge badge-cib">${(item.franchise || 'kamen_rider').replace('_', ' ').toUpperCase()}</span>
            </td>
            <td>
              <select class="condition-select" data-idx="${idx}">
                <option value="sealed" ${condition === 'sealed' ? 'selected' : ''}>New / Sealed</option>
                <option value="cib" ${condition === 'cib' ? 'selected' : ''}>Complete in Box (CIB)</option>
                <option value="used" ${condition === 'used' ? 'selected' : ''}>Loose / Used</option>
              </select>
            </td>
            <td style="text-align: right;">
              <span class="val-cell tabular font-mono">¥${jpy.toLocaleString()}</span>
              <span class="val-usd-sub tabular font-mono">~$${usd.toFixed(2)} USD</span>
            </td>
            <td style="text-align: center;">
              <button type="button" class="btn btn-remove" data-remove-idx="${idx}" aria-label="Remove item">
                ✕ Remove
              </button>
            </td>
          </tr>
        `;
      });

      html += `
            </tbody>
          </table>
        </div>
      `;

      if (container) container.innerHTML = html;

      const totalUsd = totalJpy / exchangeRate;
      if (totalJpyEl) totalJpyEl.textContent = `¥${totalJpy.toLocaleString()}`;
      if (totalUsdEl) totalUsdEl.textContent = `~$${totalUsd.toFixed(2)} USD`;
      if (totalCountEl) totalCountEl.textContent = `${list.length} item${list.length === 1 ? '' : 's'}`;

      // Bind remove buttons
      container.querySelectorAll('[data-remove-idx]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const removeIdx = Number(btn.getAttribute('data-remove-idx'));
          list.splice(removeIdx, 1);
          localStorage.setItem('tokuprice_watchlist', JSON.stringify(list));
          window.dispatchEvent(new Event('tokuprice:watchlist_updated'));
          renderWatchlist();
        });
      });

      // Bind condition change
      container.querySelectorAll('.condition-select').forEach(sel => {
        sel.addEventListener('change', (e) => {
          const itemIdx = Number(sel.getAttribute('data-idx'));
          list[itemIdx].condition = sel.value;
          localStorage.setItem('tokuprice_watchlist', JSON.stringify(list));
          renderWatchlist();
        });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Clear your entire watchlist?')) {
          localStorage.removeItem('tokuprice_watchlist');
          window.dispatchEvent(new Event('tokuprice:watchlist_updated'));
          renderWatchlist();
        }
      });
    }

    window.addEventListener('storage', renderWatchlist);
    window.addEventListener('tokuprice:watchlist_updated', renderWatchlist);
    document.addEventListener('DOMContentLoaded', renderWatchlist);
    renderWatchlist();
  })();
</script>
