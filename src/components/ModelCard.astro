---
// src/components/ModelCard.astro
import type { ModelData } from '../lib/data';
import { formatJpy, formatUsd, formatTrend } from '../lib/data';

interface Props {
  model: ModelData;
}

const { model } = Astro.props;
const { overall } = model.metrics;
const trend = formatTrend(overall.priceTrendPct30d);
const franchisePath = model.franchise === 'kamen_rider' ? 'kamen-rider' : 'ultraman';
const modelUrl = `/${franchisePath}/${model.series}/${model.slug}/`;
---

<div class="model-grid-card card">
  <!-- Row 1: Franchise pill + Release year tag (28px) -->
  <div class="card-row row-meta">
    <span class="franchise-pill">
      {model.franchise === 'kamen_rider' ? 'Kamen Rider' : 'Ultraman'}
    </span>
    <span class="year-tag tabular">{model.releaseYear}</span>
  </div>

  <!-- Row 2: English canonical title (2-line clamp, 44px) -->
  <div class="card-row row-title">
    <a href={modelUrl} class="title-link" title={model.canonicalNameEn}>
      {model.canonicalNameEn}
    </a>
  </div>

  <!-- Row 3: Japanese subtitle (1-line clamp, 20px) -->
  <div class="card-row row-subtitle font-jp" title={model.canonicalNameJa}>
    {model.canonicalNameJa}
  </div>

  <!-- Row 4: Median price row (JPY large + USD subtle, 36px) -->
  <div class="card-row row-price">
    <span class="price-jpy tabular">{formatJpy(overall.medianPriceJpy)}</span>
    <span class="price-usd tabular">~{formatUsd(overall.medianPriceUsd)}</span>
  </div>

  <!-- Row 5: 30-day trend chip + 30-day volume tag (24px) -->
  <div class="card-row row-velocity">
    <span class:list={['trend-chip', 'tabular', { 'trend-pos': trend.isPositive, 'trend-neg': trend.isNegative }]}>
      {trend.text} (30d)
    </span>
    <span class="volume-tag tabular">{overall.soldVolume30d} sold</span>
  </div>

  <!-- Row 6: Action footer: [ Track ] button (36px) -->
  <div class="card-row row-action">
    <a href={modelUrl} class="btn btn-ghost btn-sm btn-view">
      View Index
    </a>
    <button 
      type="button" 
      class="btn btn-primary btn-sm btn-track"
      onclick={`window.openTrackAlert({ slug: '${model.slug}', name: '${model.canonicalNameEn.replace(/'/g, "\\'")}', condition: 'cib', conditionLabel: 'Complete in Box', medianJpy: ${overall.medianPriceJpy} })`}
    >
      Track
    </button>
  </div>
</div>

<style>
  /* Fixed geometry per DESIGN.md §4.2: height 280px */
  .model-grid-card {
    height: 280px;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-card);
    transition: transform var(--duration-feedback) var(--ease-out),
                box-shadow var(--duration-feedback) var(--ease-out),
                border-color var(--duration-feedback) var(--ease-out);
    overflow: hidden;
  }

  .model-grid-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--elevation-raised);
    border-color: var(--border-subtle);
  }

  .card-row {
    width: 100%;
    overflow: hidden;
  }

  /* Row 1: 28px */
  .row-meta {
    height: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .franchise-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background-color: var(--surface-sunken);
    padding: 0.15rem 0.5rem;
    border-radius: var(--rounded-pill);
    border: 1px solid var(--border-default);
  }

  .year-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-subtle);
    font-family: var(--font-mono);
  }

  /* Row 2: 44px, 2-line clamp */
  .row-title {
    height: 44px;
    display: flex;
    align-items: center;
  }

  .title-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--duration-feedback) var(--ease-out);
  }

  .title-link:hover {
    color: var(--action-primary);
  }

  /* Row 3: 20px, 1-line clamp */
  .row-subtitle {
    height: 20px;
    font-size: 0.75rem;
    color: var(--text-subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Row 4: 36px */
  .row-price {
    height: 36px;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-jpy {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .price-usd {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Row 5: 24px */
  .row-velocity {
    height: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .trend-chip {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .trend-pos { color: var(--state-success); }
  .trend-neg { color: var(--state-error); }

  .volume-tag {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-family: var(--font-mono);
  }

  /* Row 6: 36px */
  .row-action {
    display: flex;
    gap: 0.5rem;
  }

  .btn-view {
    flex: 1;
  }

  .btn-track {
    flex: 1;
  }
</style>
