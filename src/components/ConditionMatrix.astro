---
// src/components/ConditionMatrix.astro
import type { ModelData } from '../lib/data';
import { formatJpy, formatUsd } from '../lib/data';

interface Props {
  model: ModelData;
}

const { model } = Astro.props;
const { byCondition } = model.metrics;

const grades = [
  {
    key: 'new_sealed',
    label: 'New / Sealed',
    subLabel: '未開封 / Factory Sealed',
    badgeClass: 'badge-sealed',
    accentColor: 'var(--grade-sealed)',
    data: byCondition.new_sealed,
    tooltip: 'Factory plastic wrap intact or Bandai outer box tape unbroken.'
  },
  {
    key: 'like_new',
    label: 'Complete in Box (CIB)',
    subLabel: '完品・美品 / Complete with Inserts',
    badgeClass: 'badge-cib',
    accentColor: 'var(--grade-cib)',
    data: byCondition.like_new,
    tooltip: 'Opened box, toy complete with all instructions, belt loops, and accessories.'
  },
  {
    key: 'used',
    label: 'Loose / Unboxed',
    subLabel: '本体のみ / Functional Display',
    badgeClass: 'badge-used',
    accentColor: 'var(--grade-used)',
    data: byCondition.used,
    tooltip: 'Unboxed toy body. Minor cosmetic play wear, sound and electronics fully functional.'
  }
];

const junkData = byCondition.damaged_or_junk;
---

<div class="condition-matrix-section">
  <div class="section-header">
    <div class="header-titles">
      <h2 class="section-title">Verified Tokyo Condition Matrix</h2>
      <p class="section-subtitle">
        Aggregated 30-day medians across verified Japanese marketplace sales (Mercari, Yahoo! Auctions, Mandarake).
      </p>
    </div>
    <div class="sample-summary tabular">
      <span>Total Sample: <strong>N={model.metrics.overall.soldVolume30d} sales</strong> / last 30d</span>
    </div>
  </div>

  <div class="matrix-grid">
    {grades.map(grade => {
      const volume = grade.data?.soldVolume30d ?? 0;
      const isLowVolume = volume < 3 || !grade.data?.medianPriceJpy;

      return (
        <div class="condition-cell card" style={`--cell-accent: ${grade.accentColor}`}>
          <div class="cell-top">
            <span class:list={['badge', grade.badgeClass]}>
              {grade.label}
            </span>
            <span class="cell-sublabel font-jp">{grade.subLabel}</span>
          </div>

          <div class="cell-body">
            {isLowVolume ? (
              <div class="low-volume-state">
                <span class="low-vol-pill">Insufficient Data (N &lt; 3)</span>
                <p class="low-vol-text">Fewer than 3 verified sales recorded in rolling 90-day window.</p>
                <button 
                  type="button" 
                  class="btn btn-ghost btn-sm manual-valuation-btn"
                  onclick={`window.openTrackAlert({ slug: '${model.slug}', name: '${model.canonicalNameEn.replace(/'/g, "\\'")}', condition: '${grade.key}', conditionLabel: '${grade.label}', medianJpy: ${model.metrics.overall.medianPriceJpy} })`}
                >
                  Request Manual Valuation
                </button>
              </div>
            ) : (
              <div class="price-stack">
                <div class="price-primary tabular">
                  {formatJpy(grade.data.medianPriceJpy)}
                </div>
                <div class="price-usd tabular">
                  ~{formatUsd(grade.data.medianPriceUsd)} USD
                </div>
                <div class="sample-caption tabular">
                  Based on <strong>{volume}</strong> verified transactions
                </div>
                {grade.data.priceMinJpy && grade.data.priceMaxJpy && (
                  <div class="price-range tabular">
                    Range: {formatJpy(grade.data.priceMinJpy)} – {formatJpy(grade.data.priceMaxJpy)}
                  </div>
                )}
              </div>
            )}
          </div>

          <div class="cell-footer">
            <button 
              type="button" 
              class="btn btn-ghost btn-sm btn-track-cell"
              onclick={`window.openTrackAlert({ slug: '${model.slug}', name: '${model.canonicalNameEn.replace(/'/g, "\\'")}', condition: '${grade.key}', conditionLabel: '${grade.label}', medianJpy: ${grade.data?.medianPriceJpy || model.metrics.overall.medianPriceJpy} })`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
              <span>Track Drop</span>
            </button>
          </div>
        </div>
      );
    })}
  </div>

  {junkData && junkData.medianPriceJpy && (
    <div class="junk-floor-bar">
      <div class="junk-badge">
        <span class="badge badge-damaged">Parts &amp; Scrap Floor</span>
      </div>
      <div class="junk-details tabular">
        Median: <strong>{formatJpy(junkData.medianPriceJpy)}</strong> (~{formatUsd(junkData.medianPriceUsd)}) • {junkData.soldVolume30d} junk/damaged sales recorded.
      </div>
      <div class="junk-note">
        Excluded from functional loose median calculation per outlier elimination policy.
      </div>
    </div>
  )}
</div>

<style>
  .condition-matrix-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .section-title {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .sample-summary {
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--surface-sunken);
    padding: 0.25rem 0.625rem;
    border-radius: var(--rounded-pill);
    border: 1px solid var(--border-default);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .condition-cell {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--rounded-card);
    transition: border-color var(--duration-feedback) var(--ease-out),
                box-shadow var(--duration-feedback) var(--ease-out);
  }

  .condition-cell:hover {
    border-color: var(--cell-accent);
    box-shadow: var(--elevation-raised);
  }

  .cell-top {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cell-sublabel {
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .cell-body {
    min-height: 110px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .price-stack {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price-primary {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .price-usd {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .sample-caption {
    font-size: 0.75rem;
    color: var(--text-subtle);
    margin-top: 0.375rem;
  }

  .price-range {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .low-volume-state {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }

  .low-vol-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--state-warning);
    background-color: var(--state-warning-surface);
    padding: 0.2rem 0.5rem;
    border-radius: var(--rounded-pill);
    width: fit-content;
  }

  .low-vol-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .cell-footer {
    border-top: 1px solid var(--border-default);
    padding-top: 0.75rem;
  }

  .btn-track-cell {
    width: 100%;
    justify-content: center;
  }

  .junk-floor-bar {
    background-color: var(--surface-sunken);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--rounded-card);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
  }

  .junk-details {
    color: var(--text-primary);
  }

  .junk-note {
    color: var(--text-subtle);
    margin-left: auto;
  }

  @media (max-width: 860px) {
    .matrix-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .junk-note {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
